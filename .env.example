# Copy to .env.local and fill in. Never commit real keys.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (local defaults come from `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-visible mirrors of the two public values above
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# F8 cost controls. Both take effect without a deploy.
GENERATION_ENABLED=true
DAILY_BUDGET_USD=5

# F12 admin gate
OWNER_USER_ID=

# Model overrides (defaults in config/models.json).
# WRITING_MODEL is the one the F14 bake-off decides. Owner's call, not the agent's.
# WRITING_MODEL=claude-sonnet-5
# HELPER_MODEL=claude-haiku-4-5-20251001
# FACTPACK_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-fable-5-1
# JUDGE_MODEL_SECONDARY=claude-opus-5-5

# Tests replay recorded fixtures by default. Set LIVE_API=1 to hit the real API.
# LIVE_API=0
# RECORD_FIXTURES=0

# Lane 4 (F9/F10) UI mock backend. Serves the endpoints in lib/schemas/api.ts from recorded
# stories under /api/mock/*, so the UI (and every e2e run) works with zero model calls while
# lane 2 builds the real /api/*. Both are needed: NEXT_PUBLIC_API_MOCK is inlined into the
# client bundle and chooses the base path, UI_MOCK_API switches the routes on server-side.
# Never set either in production.
# UI_MOCK_API=1
# NEXT_PUBLIC_API_MOCK=1
# UI_MOCK_STREAM_DELAY_MS=6
