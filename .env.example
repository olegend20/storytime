# Copy to .env.local and fill in. Never commit real keys.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (local defaults come from `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-visible mirrors of the two public values above
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# F2: Google OAuth. The provider is wired up in the login form but ships disabled -
# `supabase/config.toml` has [auth.external.google] enabled = false. Turning it on means
# setting the provider credentials in Supabase and flipping this flag; no code change.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# F8 cost controls. Both take effect without a deploy.
GENERATION_ENABLED=true
DAILY_BUDGET_USD=5

# F12 admin gate
OWNER_USER_ID=

# Model overrides (defaults in config/models.json).
# WRITING_MODEL is the one the F14 bake-off decides. Owner's call, not the agent's.
# WRITING_MODEL=claude-sonnet-5
# HELPER_MODEL=claude-haiku-4-5-20251001
# FACTPACK_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-fable-5-1
# JUDGE_MODEL_SECONDARY=claude-opus-5-5

# Tests replay recorded fixtures by default. Set LIVE_API=1 to hit the real API.
# LIVE_API=0
# RECORD_FIXTURES=0
